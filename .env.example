APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# For local development (non-Docker), use 127.0.0.1.
# For production (VPS Docker setup on global_network), use the appropriate container host (e.g. redis).
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FBR_ENABLED=false
FBR_DEFAULT_PCT_CODE=99000000
FBR_SANDBOX_MODE=true
FBR_SANDBOX_TOKEN=
FBR_SANDBOX_POST_URL=https://gw.fbr.gov.pk/di_data/v1/di/postinvoicedata_sb
FBR_SANDBOX_VALIDATE_URL=https://gw.fbr.gov.pk/di_data/v1/di/validateinvoicedata_sb
FBR_PROD_TOKEN=
FBR_PROD_POST_URL=
FBR_PROD_VALIDATE_URL=

FRONTEND_URL=http://localhost:5173

# Horizon Dashboard
# Access at: /horizon?token=YOUR_SECRET (production)
HORIZON_NAME="Everyday Store"
HORIZON_SECRET=



