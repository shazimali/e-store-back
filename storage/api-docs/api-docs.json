{
    "openapi": "3.0.0",
    "info": {
        "title": "Everyday Store API",
        "description": "API documentation for the Everyday Store Backend System",
        "contact": {
            "email": "support@everydaypak.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Primary API Gateway"
        }
    ],
    "paths": {
        "/token": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Authenticate user and retrieve token",
                "operationId": "28f7d4905c30e6c9e6113d21f3aa0c0b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "recaptcha_token"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@everydaystore.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret"
                                    },
                                    "recaptcha_token": {
                                        "type": "string",
                                        "example": "token-string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful authentication",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|AbCdEfGhIjKlMnOpQrStUvWxYz"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/invoices": {
            "get": {
                "tags": [
                    "Invoices"
                ],
                "summary": "Get paginated list of invoices",
                "operationId": "aa316025a5952ade7df615ab589f9c6e",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by quantity, price, or date",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "store_id",
                        "in": "query",
                        "description": "Filter by Store ID",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "branch_id",
                        "in": "query",
                        "description": "Filter by Branch ID",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "item_per_page",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful invoice list retrieval"
                    },
                    "401": {
                        "description": "Unauthorized / Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/invoices/store": {
            "post": {
                "tags": [
                    "Invoices"
                ],
                "summary": "Create a new invoice",
                "operationId": "874b36016601dcfe0a4d8388bee55eb9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "store_id",
                                    "branch_id",
                                    "date",
                                    "sr_number",
                                    "total_qty",
                                    "total_price",
                                    "products"
                                ],
                                "properties": {
                                    "store_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "branch_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-17"
                                    },
                                    "sr_number": {
                                        "type": "string",
                                        "example": "SR-100234"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Standard cash sale"
                                    },
                                    "total_qty": {
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "total_price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 500
                                    },
                                    "products": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "id",
                                                "qty",
                                                "price",
                                                "sale_tax",
                                                "ext_tax"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "qty": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "price": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 100
                                                },
                                                "sale_tax": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 17
                                                },
                                                "ext_tax": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "return_products": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "id",
                                                "qty",
                                                "price",
                                                "sale_tax",
                                                "ext_tax"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 2
                                                },
                                                "qty": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "price": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 100
                                                },
                                                "sale_tax": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 17
                                                },
                                                "ext_tax": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Invoice successfully created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer"
                                },
                                "example": 152
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized / Unauthenticated"
                    },
                    "422": {
                        "description": "Validation failure"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Enter your Sanctum token to authenticate requests",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Invoices",
            "description": "Invoices"
        }
    ]
}